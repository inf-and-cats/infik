+
+function practiceData(){
+  return PRACTICE?Promise.resolve(PRACTICE):fetch("content/practice.json",{cache:"no-cache"}).then(r=>{ if(!r.ok) throw new Error(r.status); return r.json(); }).then(d=>PRACTICE=d);
