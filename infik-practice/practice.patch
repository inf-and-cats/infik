+}
+
+/* ---------- экран задачи (поверх приложения, как урок) ---------- */
+const PR_KEYS=[["⇥ Tab","    "],["input()","input()"],["int(","int("],["print(","print("],["(","("],[")",")"],['"','"'],[":",":"],[",",","],["=","="],["==","=="],["%","%"],["//","//"],["if ","if "],["elif ","elif "],["else:","else:"],["and","and"],["or","or"]];
