+.ege-lock small{color:var(--ink-soft);font-size:13px;line-height:1.35}
+
+/* маркер заполнения: квадратик в правом нижнем углу выбранной ячейки (зона нажатия больше самого квадратика) */
+.xl-t td{position:relative}
+.xl-handle{position:absolute;right:-5px;bottom:-5px;width:11px;height:11px;background:var(--xl-sel);border:2px solid var(--xl-bg);border-radius:2px;z-index:2;touch-action:none;cursor:crosshair;animation:xl-pulse 1.4s ease-in-out infinite}
+.xl-handle::before{content:"";position:absolute;inset:-14px}
+@keyframes xl-pulse{50%{transform:scale(1.35)}}
+@media (prefers-reduced-motion: reduce){ .xl-handle{animation:none} }
+.xl-dragging .xl-handle{animation:none;transform:scale(1.4)}
+.xl-t td.xl-drag{box-shadow:inset 0 0 0 2px var(--xl-sel);background:var(--xl-mark)}
+.xl-t tr:last-child td .xl-handle{bottom:-1px}
+.xl-t td:last-child .xl-handle{right:-1px}
+.xl-hint{display:flex;gap:10px;align-items:flex-start;margin:0;font-size:14px;line-height:1.4;background:var(--surface);border:2px solid var(--purple);border-radius:12px;padding:10px 12px}
+.xl-hq{flex:none;width:12px;height:12px;margin-top:4px;background:var(--xl-sel);border-radius:2px}
+.xl-hint.xl-nudge{animation:xl-nudge .4s}
+@keyframes xl-nudge{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
+.xl-t td.xl-goal{box-shadow:inset 0 0 0 3px var(--lime-2)}
+.xl-t td.xl-pick{background:var(--xl-mark)}
+.xl-editrow{display:flex;align-items:center;gap:10px;font-family:var(--f-code)}
+.xl-num{width:120px;font-family:var(--f-code);font-size:18px;padding:8px 10px;border:2px solid var(--purple);border-radius:10px;background:var(--xl-bg);color:var(--xl-ink)}
+
+/* «Как это в Calc»: кнопка на шаге и шторка со скриншотом настоящего LibreOffice */
+.xl-calc{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;border:2px solid var(--line);border-bottom-width:4px;background:var(--surface);color:var(--ink);border-radius:12px;padding:6px 12px;font-weight:800;font-size:14px}
+.xl-calc svg{width:20px;height:20px;flex:none}
+.xl-calc:active{transform:translateY(2px);border-bottom-width:2px}
+.xl-shot{margin:0 0 14px;display:flex;flex-direction:column;gap:8px}
+.xl-shot img{display:block;width:100%;height:auto;border-radius:10px;border:2px solid var(--line);background:#fff}
+.xl-shot figcaption{font-size:14px;line-height:1.4}
+.xl-shot figcaption code{font-family:var(--f-code);font-size:.9em;font-weight:600;background:var(--surface-2);border:1.5px solid var(--line);border-radius:6px;padding:0 5px}
+.xl-zoom{overflow-x:auto;-webkit-overflow-scrolling:touch}
+.xl-shot img{cursor:zoom-in}
+.xl-shot.big img{width:220%;max-width:none;cursor:zoom-out}
