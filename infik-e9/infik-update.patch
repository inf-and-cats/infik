+/* Электронная таблица в уроках ЕГЭ (js/sheet.js) */
+:root{ --xl-bg:#ffffff; --xl-head:#eeedf8; --xl-grid:#d9d6f3; --xl-ink:#262b69; --xl-f:#f6f9c4; --xl-sel:#512da8; --xl-mark:#e3dcfb; }
+@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ --xl-bg:#1c1f4f; --xl-head:#262a63; --xl-grid:#33387a; --xl-ink:#ecebff; --xl-f:#3a3d2a; --xl-sel:#b9a2ff; --xl-mark:#3b2f7a; } }
+:root[data-theme="dark"]{ --xl-bg:#1c1f4f; --xl-head:#262a63; --xl-grid:#33387a; --xl-ink:#ecebff; --xl-f:#3a3d2a; --xl-sel:#b9a2ff; --xl-mark:#3b2f7a; }
+
+.xl{border:2px solid var(--line);border-radius:14px;overflow:hidden;background:var(--xl-bg);color:var(--xl-ink)}
+.xl-bar{display:flex;align-items:center;gap:8px;min-height:40px;padding:6px 10px;border-bottom:1px solid var(--xl-grid);background:var(--xl-head);font-family:var(--f-code);font-size:14px}
+.xl-addr{flex:none;min-width:38px;font-weight:800;color:var(--xl-ink);background:var(--xl-bg);border:1px solid var(--xl-grid);border-radius:8px;padding:3px 6px;text-align:center}
+.xl-addr:empty{visibility:hidden}
+.xl-fx{flex:none;font-style:italic;color:var(--ink-soft);font-family:Georgia,serif}
+.xl-src{flex:1;min-width:0;overflow-wrap:anywhere;line-height:1.5;background:var(--xl-bg);border:1px solid var(--xl-grid);border-radius:8px;padding:3px 8px;min-height:30px;font-size:15px;font-weight:600}
+.xl-src.xl-has-f{color:var(--purple-ink);border:2px solid var(--purple);background:var(--xl-f)}
+:root{--xl-flash:#ecf141}
+.xl-src.xl-flash{animation:xl-flash .6s ease-out}
+@keyframes xl-flash{from{box-shadow:0 0 0 4px var(--xl-flash)}to{box-shadow:0 0 0 0 transparent}}
+@media (prefers-reduced-motion: reduce){ .xl-src.xl-flash{animation:none} }
+.xl-bar{position:relative}
+.xl-src.xl-edit{font-weight:400;color:var(--xl-ink);background:var(--xl-bg);border:2px solid var(--purple);border-radius:8px;padding:3px 6px;min-height:30px;display:flex;flex-wrap:wrap;align-items:center;gap:2px}
+.xl-ph{color:var(--ink-soft);font-family:var(--f-body);font-size:13px}
+.xl-tok{border:0;background:var(--surface-2);color:var(--xl-ink);border-radius:5px;padding:1px 3px;font-family:var(--f-code);font-size:14px;line-height:1.5}
+.xl-input{flex:1;width:100%;border:0;outline:none;background:transparent;color:var(--xl-ink);font-family:var(--f-code);font-size:16px;padding:2px 0}
+.xl-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
+.xl-t{border-collapse:collapse;font-family:var(--f-code);font-size:13px;min-width:100%}
+@media (max-width:400px){ .xl-t{font-size:12px} .xl-t th,.xl-t td{padding:0 4px} .xl-t td{min-width:30px} }
+.xl.no-bar .xl-bar{display:none}
+.xl-t th,.xl-t td{border:1px solid var(--xl-grid);height:30px;padding:0 5px;white-space:nowrap}
