+.xl-t tbody th{background:var(--xl-head);color:var(--ink-soft);font-weight:600;font-size:12px;min-width:28px;text-align:center}
+.xl-t th.xl-corner{min-width:28px}
+.xl-t td{text-align:left;min-width:34px}
+.xl-t td.xl-n{text-align:right}
+.xl-t td.xl-f{background:var(--xl-f)}
+.xl-t td.xl-err{color:var(--bad);font-weight:600}
+.xl-t .xl-gap{min-width:8px;width:8px;padding:0;font-size:0}
+.xl-t td.xl-sel{outline:2px solid var(--xl-sel);outline-offset:-2px}
+.xl-t tr.xl-more td,.xl-t tr.xl-more th{height:22px;text-align:center;color:var(--ink-soft);background:var(--xl-head)}
+.xl-t tbody th[role="button"]{cursor:pointer}
+.xl-t tr.xl-mark td,.xl-t tr.xl-mark th{background:var(--xl-mark)}
